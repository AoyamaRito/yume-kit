# GA4 データ状態監視の設定
# このファイルを .env にコピーして埋める

# 必須
GA4_PROPERTY_ID=123456789
GA4_CREDENTIALS_FILE=/path/to/service-account-key.json

# プロパティのタイムゾーン (UTC+9 なら 9, UTC なら 0)
GA4_TZ_OFFSET_HOURS=9

# アラート閾値
MAX_LAG_MIN=15
DROP_THRESHOLD_PCT=-80

# 任意: Measurement Protocol テストヒット (受信経路の死活検証)
MP_API_SECRET=
MP_MEASUREMENT_ID=G-XXXXXXXX
PING_TIMEOUT_MIN=30

# 任意: Slack 通知 (未設定ならコンソールのみ)
SLACK_WEBHOOK_URL=
